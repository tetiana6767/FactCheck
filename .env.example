# Доступ до OpenRouter. Секретне значення тут не зберігати.
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# role — окрема модель для кожної ролі; single — одна модель для всіх ролей.
OPENROUTER_ROUTING_MODE=role
OPENROUTER_EXECUTION_MODE=economy
OPENROUTER_MODEL_DEFAULT=openai/gpt-4o-mini

# Основні агенти.
OPENROUTER_MODEL_CLAIM=mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_MODEL_EVIDENCE=deepseek/deepseek-v4.1-flash-20260910
OPENROUTER_MODEL_SOURCE=qwen/qwen3.5-9b
OPENROUTER_MODEL_LINGUISTIC=mistralai/mistral-small-3.2-24b-instruct

# Контрольні агенти.
OPENROUTER_MODEL_SKEPTIC=deepseek/deepseek-v4.1-flash-20260910
OPENROUTER_MODEL_VERIFIER=openai/gpt-4o-mini
OPENROUTER_MODEL_ARBITER=openai/gpt-4o-mini

# Необов'язкова резервна модель для тимчасових відмов.
OPENROUTER_MODEL_FALLBACK=mistralai/mistral-small-3.2-24b-instruct

# Межі одного модельного виклику.
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_REPORT_COST_USD=0.02
OPENROUTER_MAX_INPUT_PRICE_PER_MILLION=0.15
OPENROUTER_MAX_OUTPUT_PRICE_PER_MILLION=0.60
